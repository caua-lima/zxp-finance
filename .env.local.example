NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only, NUNCA use NEXT_PUBLIC_ aqui)
# Vem do arquivo JSON gerado em: Firebase Console > Configurações do
# projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push (notificação diária de "quanto posso gastar hoje")
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Protege o endpoint de cron (a Vercel manda esse valor automaticamente
# no header Authorization quando essa env var existe no projeto)
CRON_SECRET=

# Ponte com o ZXP Tasks (lista de desejos) — ver memória de projeto
# "integracao-tasks-finance". O mesmo TASKS_FINANCE_BRIDGE_SECRET precisa
# estar configurado nos dois apps (é o mesmo valor nos dois .env).
TASKS_API_URL=
TASKS_FINANCE_BRIDGE_SECRET=

# Consultor de viabilidade financeira (chat com Claude Haiku 4.5, tool use)
# Chave de API da Anthropic com faturamento próprio — NÃO é a mesma coisa
# da assinatura do Claude Code. Gerar em console.anthropic.com.
ANTHROPIC_API_KEY=
